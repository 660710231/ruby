<!DOCTYPE html>
<html>
  <head>
    <title>Store</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
  </head>

  <body>
    <!-- 1. Nav link ไปยัง Products -->
    <nav>
      <%= link_to "Home", root_path %> |
      <%= link_to "All Products", products_path %> |
      <%= link_to "New Product", new_product_path %>
    </nav>

    <!-- 2. จุดแสดง Flash messages (Notice / Alert) -->
    <% flash.each do |type, message| %>
      <div class="flash <%= type %>" style="color: green; padding: 10px; margin: 10px 0; background: #e8f5e9;">
        <%= message %>
      </div>
    <% end %>

    <!-- เนื้อหาหลักของแต่ละหน้า -->
    <%= yield %>
  </body>
</html>